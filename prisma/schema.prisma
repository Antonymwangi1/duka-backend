generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  OWNER
  ADMIN
  CASHIER
}

enum Currency {
  KES
  USD
  EUR
  GBP
}

enum Plan {
  FREE
  BASIC
  PREMIUM
}

enum PaymentMethod {
  CASH
  MPESA
}

enum MovementType {
  SALE
  RESTOCK
  ADJUSTMENT
  DAMAGE
}

// ============================================================
// MODELS
// ============================================================

model User {
  id           String   @id @default(uuid())
  fullname     String
  email        String   @unique
  phone        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(CASHIER)
  shopId       String?  @map("shop_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  shop           Shop?           @relation("ShopStaff", fields: [shopId], references: [id])
  ownedShops     Shop[]          @relation("ShopOwner")
  sales          Sale[]
  stockMovements StockMovement[]
  reports        Report[]

  @@index([shopId], name: "idx_user_shop_id")
  @@index([role], name: "idx_user_role")
  @@map("users")
}

model Shop {
  id                       String    @id @default(uuid())
  shopName                 String    @map("shop_name")
  address                  String
  ownerId                  String    @map("owner_id")
  phone                    String    @unique
  currency                 Currency  @default(KES)
  defaultLowStockThreshold Int       @default(5) @map("default_low_stock_threshold")
  plan                     Plan      @default(FREE)
  planExpiry               DateTime? @map("plan_expiry")
  isActive                 Boolean   @default(true) @map("is_active")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  owner          User            @relation("ShopOwner", fields: [ownerId], references: [id])
  staff          User[]          @relation("ShopStaff")
  sales          Sale[]
  categories     Category[]
  products       Product[]
  stockMovements StockMovement[]
  reports        Report[]

  @@index([ownerId], name: "idx_shop_owner_id")
  @@map("shops")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  shopId    String   @map("shop_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([shopId, name], name: "unique_category_per_shop")
  @@index([shopId], name: "idx_category_shop_id")
  @@map("categories")
}

model Product {
  id                String   @id @default(uuid())
  shopId            String   @map("shop_id")
  categoryId        String?  @map("category_id")
  name              String
  description       String?
  sku               String?
  barcode           String?
  unit              String?
  buyingPrice       Decimal  @map("buying_price") @db.Decimal(10, 2)
  sellingPrice      Decimal  @map("selling_price") @db.Decimal(10, 2)
  stockQuantity     Int      @default(0) @map("stock_quantity")
  lowStockThreshold Int?     @map("low_stock_threshold")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  shop           Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@unique([shopId, sku], name: "unique_product_sku_per_shop")
  @@unique([shopId, barcode], name: "unique_product_barcode_per_shop")
  @@index([shopId], name: "idx_product_shop_id")
  @@index([categoryId], name: "idx_product_category_id")
  @@map("products")
}

model Sale {
  id            String        @id @default(uuid())
  shopId        String        @map("shop_id")
  servedById    String        @map("served_by_id")
  paymentMethod PaymentMethod @map("payment_method")
  subtotal      Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")

  shop      Shop       @relation(fields: [shopId], references: [id])
  servedBy  User       @relation(fields: [servedById], references: [id])
  saleItems SaleItem[]

  @@index([shopId], name: "idx_sale_shop_id")
  @@index([servedById], name: "idx_sale_served_by_id")
  @@index([createdAt], name: "idx_sale_created_at")
  @@map("sales")
}

model SaleItem {
  id          String   @id @default(uuid())
  saleId      String   @map("sale_id")
  productId   String   @map("product_id")
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  buyingPrice Decimal  @map("buying_price") @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId], name: "idx_sale_item_sale_id")
  @@index([productId], name: "idx_sale_item_product_id")
  @@map("sale_items")
}

model StockMovement {
  id            String       @id @default(uuid())
  shopId        String       @map("shop_id")
  productId     String       @map("product_id")
  performedById String       @map("performed_by_id")
  movementType  MovementType @map("movement_type")
  quantity      Int
  notes         String?
  createdAt     DateTime     @default(now()) @map("created_at")

  shop        Shop    @relation(fields: [shopId], references: [id])
  product     Product @relation(fields: [productId], references: [id])
  performedBy User    @relation(fields: [performedById], references: [id])

  @@index([shopId], name: "idx_stock_movement_shop_id")
  @@index([productId], name: "idx_stock_movement_product_id")
  @@index([performedById], name: "idx_stock_movement_performed_by_id")
  @@map("stock_movements")
}

model Report {
  id            String   @id @default(uuid())
  shopId        String   @map("shop_id")
  generatedById String   @map("generated_by_id")
  reportType    String   @map("report_type")
  periodStart   DateTime @map("period_start")
  periodEnd     DateTime @map("period_end")
  reportData    Json     @map("report_data")
  createdAt     DateTime @default(now()) @map("created_at")

  shop        Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  generatedBy User @relation(fields: [generatedById], references: [id])

  @@unique([shopId, reportType, periodStart, periodEnd])
  @@index([shopId], name: "idx_report_shop_id")
  @@index([reportType], name: "idx_report_type")
  @@map("reports")
}
